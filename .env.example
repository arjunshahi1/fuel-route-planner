# Copy to .env and adjust. Every value is optional.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Routing provider: "osrm" (public demo server, no key) or "ors" (OpenRouteService).
# If ORS_API_KEY is set and ROUTING_PROVIDER is unset, ORS is used.
# ROUTING_PROVIDER=osrm
# ORS_API_KEY=your-openrouteservice-key

# Vehicle and planning parameters
# VEHICLE_RANGE_MILES=500
# VEHICLE_MPG=10
# CORRIDOR_MILES=10
# START_RADIUS_MILES=25
# STOP_PENALTY=5
# API_RATE_LIMIT=60/minute
